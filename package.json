{
  "name": "martian-scrap-co",
  "productName": "Martian Scrap Co.",
  "version": "0.0.0",
  "private": true,
  "description": "First-person co-op Mars scrapyard recycling game.",
  "author": "David Seco Diaz",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.electron.json",
    "build:renderer": "vite build",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "npm run typecheck && npm run build:renderer && npm run build:electron",
    "test": "vitest run",
    "preview": "vite preview",
    "electron:start": "npm run build && electron .",
    "electron:dev": "npm run build:electron && node tools/run-electron-dev.mjs",
    "package": "npm run build && electron-builder --win --config electron-builder.yml"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/three": "0.186.0",
    "electron": "44.10.0",
    "electron-builder": "26.17.0",
    "three": "0.186.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
